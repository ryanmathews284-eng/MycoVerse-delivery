---
// src/components/FeaturedProducts.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PRODUCTS } from '../data/products';
import VariantSelector from './VariantSelector.astro';

interface Props {
  totalCatalogItems: string;
}
const { totalCatalogItems } = Astro.props;

// Glob import all product images from src/assets/images at build time
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png,webp}');

const categories = ['chocolates', 'strains', 'microdose', 'gummies'] as const;
const featuredProducts = categories.flatMap(cat => 
  PRODUCTS.filter(p => p.category === cat).slice(0, 3)
);
---
<section class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-16 bg-[#3E2723]/5 rounded-3xl my-10 border border-[#3E2723]/10">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 px-1">
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#1A120B]">Featured Dispatch Catalog ({totalCatalogItems})</h2>
      <p class="text-xs uppercase tracking-widest text-[#C68B59] mt-2 font-semibold">Elite Formulations • Fully Shipped</p>
    </div>
    <a href="/shop" class="mt-4 md:mt-0 text-xs font-bold text-[#1A120B] hover:text-[#C68B59] transition-colors flex items-center gap-1">View Full Store &rarr;</a>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
    {featuredProducts.map((prod) => {
      const imagePath = `/src/assets/images/${prod.slug}.jpg`;
      const resolvedImage = images[imagePath];

      return (
        <article 
          class="bg-[#FDFBF7] border border-[#3E2723]/15 rounded-xl sm:rounded-2xl overflow-hidden shadow-sm flex flex-col justify-between"
          data-product-card={prod.id}
        >
          <div>
            <div class="h-40 sm:h-48 bg-stone-200 relative overflow-hidden">
              {resolvedImage ? (
                <Image src={resolvedImage()} alt={prod.name} class="w-full h-full object-cover" width={500} quality={80} />
              ) : (
                <img src={`/images/${prod.slug}.jpg`} alt={prod.name} class="w-full h-full object-cover" />
              )}
              <span class="absolute top-2 left-2 bg-[#D4A373] text-[#1A120B] text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded shadow">{prod.badge}</span>
            </div>
            <div class="p-3.5 sm:p-5">
              <div class="flex justify-between items-center mb-1">
                <span class="text-[9px] uppercase font-bold text-stone-400 tracking-wider">{prod.categoryTitle}</span>
                <span class="text-[11px] font-bold text-[#C68B59]">⭐ {prod.rating} ({prod.reviewsCount})</span>
              </div>
              <h3 class="text-sm sm:text-base font-bold text-[#1A120B] mb-1 truncate">{prod.name}</h3>
              <p class="text-[11px] text-[#3E2723]/70 mb-3 line-clamp-2">{prod.description}</p>
              
              <div class="mb-3 bg-[#3E2723]/5 p-2 rounded-lg flex items-center justify-between">
                <span class="text-[11px] text-stone-500 font-medium">Price:</span>
                <span class="product-price text-sm font-extrabold text-[#1A120B]" data-base-price={prod.variants[0].price}>
                  ${prod.variants[0].price.toFixed(2)} USD
                </span>
              </div>

              <div class="mb-3">
                <VariantSelector productId={prod.id} variants={prod.variants} />
              </div>
            </div>
          </div>
          
          <div class="p-3.5 sm:p-5 pt-0 space-y-2">
            <button 
              type="button"
              class="add-to-cart-btn w-full bg-[#1A120B] text-[#D4A373] hover:bg-[#3E2723] transition-all text-center text-[11px] sm:text-xs font-bold py-2.5 rounded-lg shadow cursor-pointer flex items-center justify-center gap-2"
              data-product-id={prod.id}
              data-product-name={prod.name}
              data-product-image={`/images/${prod.slug}.jpg`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              Add to Dispatch Cart
            </button>

            <a href={`/shop/${prod.slug}`} class="block w-full text-stone-600 hover:text-[#1A120B] text-center text-[10px] font-semibold py-1 transition-colors">
              View Details &rarr;
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  import { addToCart } from '../store/cartStore.ts';

  document.querySelectorAll('.add-to-cart-btn').forEach(button => {
    button.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLElement;
      const card = btn.closest('article');
      if (!card) return;

      const id = btn.dataset.productId!;
      const name = btn.dataset.productName!;
      const image = btn.dataset.productImage!;

      const selectEl = card.querySelector('select') as HTMLSelectElement;
      let variantName = selectEl ? selectEl.options[selectEl.selectedIndex].text.split(' - ')[0] : 'Standard';
      let price = selectEl ? parseFloat(selectEl.value) : 0;

      if (isNaN(price)) {
        const priceEl = card.querySelector('.product-price');
        price = priceEl ? parseFloat(priceEl.textContent?.replace('$', '').replace(' USD', '') || '0') : 0;
      }

      addToCart({
        id,
        name,
        price,
        image,
        variant: variantName
      });

      if ((window as any).openMycoVerseCart) {
        (window as any).openMycoVerseCart();
      }
    });
  });
</script>