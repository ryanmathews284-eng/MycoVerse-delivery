---
import { Image } from 'astro:assets';

import catChocolates from '../assets/images/cat-chocolates.jpg';
import catStrains from '../assets/images/cat-strains.jpg';
import catMicrodose from '../assets/images/cat-microdose.jpg';
import catGummies from '../assets/images/cat-gummies.jpg';
import catBulk from '../assets/images/cat-bulk.jpg';
---
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="text-center mb-12">
    <h2 class="text-2xl sm:text-3xl font-bold text-[#1A120B]">Shop by Category</h2>
    <p class="text-xs uppercase tracking-widest text-[#8E4A23] mt-2 font-semibold">Curated Psychedelic & Botanical Collections</p>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    <!-- Chocolates -->
    <a href="/shop/chocolates" class="group relative rounded-xl overflow-hidden h-64 sm:h-80 shadow-md hover:shadow-2xl transition-all flex flex-col justify-end p-4 sm:p-6 border border-[#3E2723]/15">
      <Image src={catChocolates} alt="Artisan Chocolates" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={600} quality={80} />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1A120B]/90 via-[#1A120B]/40 to-transparent"></div>
      <div class="relative z-10">
        <span class="inline-block bg-[#D4A373]/90 text-[#1A120B] text-[10px] font-bold px-2 py-0.5 rounded-full mb-2">Chocolates</span>
        <h3 class="text-base sm:text-lg font-bold text-white mb-1 group-hover:text-[#D4A373] transition-colors">Artisan Chocolates</h3>
        <p class="text-[11px] sm:text-xs text-white/80 leading-relaxed mb-3 line-clamp-2">Fusion Bars & Neau Tropics crafted with active extracts.</p>
        <span class="text-[11px] font-semibold text-[#D4A373] flex items-center gap-1 group-hover:translate-x-1 transition-transform">Browse &rarr;</span>
      </div>
    </a>

    <!-- Strains -->
    <a href="/shop/strains" class="group relative rounded-xl overflow-hidden h-64 sm:h-80 shadow-md hover:shadow-2xl transition-all flex flex-col justify-end p-4 sm:p-6 border border-[#3E2723]/15">
      <Image src={catStrains} alt="Dried Strains" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={600} quality={80} />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1A120B]/90 via-[#1A120B]/40 to-transparent"></div>
      <div class="relative z-10">
        <span class="inline-block bg-[#D4A373]/90 text-[#1A120B] text-[10px] font-bold px-2 py-0.5 rounded-full mb-2">Strains</span>
        <h3 class="text-base sm:text-lg font-bold text-white mb-1 group-hover:text-[#D4A373] transition-colors">Dried Strains</h3>
        <p class="text-[11px] sm:text-xs text-white/80 leading-relaxed mb-3 line-clamp-2">Golden Teacher, Blue Meanies, and APE tiers.</p>
        <span class="text-[11px] font-semibold text-[#D4A373] flex items-center gap-1 group-hover:translate-x-1 transition-transform">Browse &rarr;</span>
      </div>
    </a>

    <!-- Microdose -->
    <a href="/shop/microdose" class="group relative rounded-xl overflow-hidden h-64 sm:h-80 shadow-md hover:shadow-2xl transition-all flex flex-col justify-end p-4 sm:p-6 border border-[#3E2723]/15">
      <Image src={catMicrodose} alt="Microdose Stacks" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={600} quality={80} />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1A120B]/90 via-[#1A120B]/40 to-transparent"></div>
      <div class="relative z-10">
        <span class="inline-block bg-[#D4A373]/90 text-[#1A120B] text-[10px] font-bold px-2 py-0.5 rounded-full mb-2">Microdose</span>
        <h3 class="text-base sm:text-lg font-bold text-white mb-1 group-hover:text-[#D4A373] transition-colors">Microdose Stacks</h3>
        <p class="text-[11px] sm:text-xs text-white/80 leading-relaxed mb-3 line-clamp-2">Stamets Protocol and daily focus & flow blends.</p>
        <span class="text-[11px] font-semibold text-[#D4A373] flex items-center gap-1 group-hover:translate-x-1 transition-transform">Browse &rarr;</span>
      </div>
    </a>

    <!-- Gummies -->
    <a href="/shop/gummies" class="group relative rounded-xl overflow-hidden h-64 sm:h-80 shadow-md hover:shadow-2xl transition-all flex flex-col justify-end p-4 sm:p-6 border border-[#3E2723]/15">
      <Image src={catGummies} alt="Gummies & Extracts" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={600} quality={80} />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1A120B]/90 via-[#1A120B]/40 to-transparent"></div>
      <div class="relative z-10">
        <span class="inline-block bg-[#D4A373]/90 text-[#1A120B] text-[10px] font-bold px-2 py-0.5 rounded-full mb-2">Extracts</span>
        <h3 class="text-base sm:text-lg font-bold text-white mb-1 group-hover:text-[#D4A373] transition-colors">Gummies & Extracts</h3>
        <p class="text-[11px] sm:text-xs text-white/80 leading-relaxed mb-3 line-clamp-2">Muscimol Amanita extracts and botanical drops.</p>
        <span class="text-[11px] font-semibold text-[#D4A373] flex items-center gap-1 group-hover:translate-x-1 transition-transform">Browse &rarr;</span>
      </div>
    </a>

    <!-- Bulk & Wholesale -->
    <a href="/shop/bulk" class="group relative rounded-xl overflow-hidden h-64 sm:h-80 shadow-md hover:shadow-2xl transition-all flex flex-col justify-end p-4 sm:p-6 border border-[#3E2723]/15 col-span-2 lg:col-span-1">
      <Image src={catBulk} alt="Bulk & Wholesale Fulfillment" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" width={600} quality={80} />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1A120B]/90 via-[#1A120B]/40 to-transparent"></div>
      <div class="relative z-10">
        <span class="inline-block bg-[#D4A373]/90 text-[#1A120B] text-[10px] font-bold px-2 py-0.5 rounded-full mb-2">B2B Wholesale</span>
        <h3 class="text-base sm:text-lg font-bold text-white mb-1 group-hover:text-[#D4A373] transition-colors">Bulk & Wholesale</h3>
        <p class="text-[11px] sm:text-xs text-white/80 leading-relaxed mb-3 line-clamp-2">Enterprise tier volume discounts and custom white-label dispatch from LA.</p>
        <span class="text-[11px] font-semibold text-[#D4A373] flex items-center gap-1 group-hover:translate-x-1 transition-transform">View Tiers &rarr;</span>
      </div>
    </a>
  </div>
</section>