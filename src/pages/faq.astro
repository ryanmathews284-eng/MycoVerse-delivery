---
import Layout from '../layouts/Layout.astro';
---
<Layout title="FAQ | Mycroverse Delivery">
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-[#3E2723] mb-4">Frequently Asked Questions</h1>
    <p class="text-gray-600 mb-8">Got questions? We've got answers.</p>

    <div class="space-y-6">
      <div class="bg-[#FDFBF7] p-6 rounded-xl border border-[#3E2723]/20">
        <h3 class="font-bold text-[#3E2723] text-lg mb-2">How do I place an order?</h3>
        <p class="text-gray-700">Simply browse our shop, add items to your cart, and proceed to checkout. Fill in your delivery details and choose your preferred payment method. Our team will review and contact you with instructions within 2 hours.</p>
      </div>

      <div class="bg-[#FDFBF7] p-6 rounded-xl border border-[#3E2723]/20">
        <h3 class="font-bold text-[#3E2723] text-lg mb-2">What payment methods do you accept?</h3>
        <p class="text-gray-700">We accept secure digital payment options including Bitcoin (BTC) and other listed checkout methods.</p>
      </div>

      <div class="bg-[#FDFBF7] p-6 rounded-xl border border-[#3E2723]/20">
        <h3 class="font-bold text-[#3E2723] text-lg mb-2">Is my information secure and discreet?</h3>
        <p class="text-gray-700">Yes, absolute discretion and privacy are our top priorities. All customer data and delivery communications are handled securely.</p>
      </div>
    </div>
  </main>
</Layout>