---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import { PRODUCTS } from '../data/products';
import { SITE_STATS } from '../data/config';

// Updated stats configuration reflecting the $250 free shipping threshold
const updatedStats = {
  ...SITE_STATS,
  freeShippingThreshold: 250
};

const totalCatalogCount = `${PRODUCTS.length} Items Available`;
---

<Layout title="MycroVerse Delivery | Premium Psychedelic Dispatch & Nootropics Los Angeles">
  <main>
    <Hero hqLocation="Los Angeles, CA" />
    <StatsCounter stats={updatedStats} />
    <CategoryGrid />
    <FeaturedProducts totalCatalogItems={totalCatalogCount} />
    <CustomerReviews />
  </main>
</Layout>