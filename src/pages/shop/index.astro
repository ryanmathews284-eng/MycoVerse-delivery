---
// src/pages/shop/index.astro
import Layout from '../../layouts/Layout.astro';

// The 5 main category cards overview with keyword-rich enhancements
const categories = [
  {
    title: "Artisan Chocolates",
    slug: "chocolates",
    description: "Precision-dosed Belgian dark and milk chocolate bars expertly crafted to mask earthy undertones.",
    badge: "Most Popular",
    itemCount: "10 Products"
  },
  {
    title: "Dried Strains",
    slug: "strains",
    description: "Hand-trimmed, top-shelf dried botanical strains cultivated for optimal potency, purity, and clarity.",
    badge: "Top Shelf",
    itemCount: "8 Strains"
  },
  {
    title: "Microdose Stacks",
    slug: "microdose",
    description: "Carefully calibrated stack capsules designed for daily cognitive enhancement, focus, and routine wellness.",
    badge: "Routine Ready",
    itemCount: "10 Stacks"
  },
  {
    title: "Gummies & Extracts",
    slug: "gummies",
    description: "Delightfully flavored fast-acting botanical extracts and premium-grade infused gummies.",
    badge: "Fast Acting",
    itemCount: "10 Extracts"
  },
  {
    title: "Wholesale & Bulk Orders",
    slug: "bulk",
    description: "Custom commercial quantities, white-label options, and priority dispatch for verified partners.",
    badge: "Commercial",
    itemCount: "Inquire"
  }
];
---

<Layout title="Shop Catalog & Specialized Collections | MycroVerse Los Angeles">
  <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-12">
    {/* Breadcrumbs */}
    <nav class="text-xs text-stone-500 mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-[#D4A373]">Home</a>
      <span>/</span>
      <span class="text-[#D4A373] font-semibold">Shop Catalog</span>
    </nav>

    {/* Header Banner */}
    <div class="bg-[#3E2723]/10 border border-[#3E2723]/15 rounded-3xl p-8 mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-[#C68B59] bg-[#C68B59]/10 px-3 py-1 rounded-full">
        Collections Overview
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1A120B] mt-3 mb-2">Explore Our Specialized Collections</h1>
      <p class="text-sm sm:text-base text-[#3E2723]/80 max-w-2xl">
        Browse our curated catalog designed for precise dosing, reliable quality, and fast dispatch across Los Angeles. Select a category below to view available items.
      </p>
    </div>

    {/* Category Grid Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6 mb-16">
      {categories.map((cat) => (
        <a 
          href={`/shop/${cat.slug}`}
          class="group bg-[#FDFBF7] border border-[#3E2723]/15 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#D4A373] transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="bg-[#D4A373]/15 text-[#C68B59] text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">
                {cat.badge}
              </span>
              <span class="text-xs font-semibold text-stone-500 bg-stone-100 px-2 py-0.5 rounded">
                {cat.itemCount}
              </span>
            </div>
            
            <h3 class="text-lg font-bold text-[#1A120B] group-hover:text-[#C68B59] transition-colors mb-2">
              {cat.title}
            </h3>
            
            <p class="text-xs text-[#3E2723]/70 leading-relaxed mb-6">
              {cat.description}
            </p>
          </div>

          <div class="pt-4 border-t border-stone-200/60 flex items-center justify-between text-xs font-bold text-[#C68B59]">
            <span>Browse Collection</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>