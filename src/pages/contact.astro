---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us | Mycroverse Delivery">
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-[#3E2723] mb-4">Contact Us</h1>
    <p class="text-gray-600 mb-8">Reach out to our support and dispatch team.</p>

    <div class="bg-[#FDFBF7] p-8 rounded-xl border border-[#3E2723]/20 max-w-xl">
      <p class="text-gray-700 mb-4">Have questions regarding an active order, delivery zones, or product details? Get in touch with us directly:</p>
      <ul class="space-y-3 text-gray-800">
        <li><strong>Support Hours:</strong> Monday – Sunday (9:00 AM – 10:00 PM)</li>
        <li><strong>Response Time:</strong> Typically within 1 to 2 hours</li>
      </ul>
    </div>
  </main>
</Layout>