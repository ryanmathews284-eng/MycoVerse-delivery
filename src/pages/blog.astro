---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';

// SEO schema markup for the blog archive
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Mycroverse Journal & Updates",
  "description": "Stay up to date with product highlights, strain spotlights, and community insights from Mycroverse Delivery.",
  "url": "https://mycroverse.com/blog"
};
---

<Layout title="Journal, Strain Guides & Updates | Mycroverse Delivery">
  <!-- Schema Markup Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <main class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-[#C68B59] bg-[#C68B59]/10 px-3 py-1 rounded-full">
        Expert Insights & Guides
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#3E2723] mt-3 mb-3">Mycroverse Journal & Updates</h1>
      <p class="text-base text-[#3E2723]/80 max-w-2xl">
        Explore high-volume category breakdowns, strain spotlights, precision dosing guides, and community dispatches for premium nootropics and botanical products.
      </p>
    </header>
    
    <article class="bg-[#FDFBF7] p-6 sm:p-8 rounded-2xl border border-[#3E2723]/15 shadow-sm hover:border-[#D4A373] transition-all">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-[10px] font-bold uppercase tracking-wider bg-[#D4A373]/15 text-[#C68B59] px-2.5 py-1 rounded-full">
          Featured Release
        </span>
        <time datetime="2026-08" class="text-xs font-semibold text-stone-500">Published: August 2026</time>
      </div>

      <h2 class="text-xl sm:text-2xl font-bold text-[#1A120B] mb-3">Welcome to Mycroverse Delivery: The Standard in Modern Botanical Dispatch</h2>
      
      <p class="text-sm sm:text-base text-[#3E2723]/80 leading-relaxed mb-6">
        We are dedicated to bringing you top-tier quality items with reliable, discreet service across Los Angeles. Keep an eye on this space for our latest seasonal drops, comprehensive strain analysis, and cognitive enhancement guides.
      </p>

      <div class="pt-4 border-t border-stone-200/60 flex items-center justify-between text-xs font-bold text-[#C68B59]">
        <span>Standard Dispatch Protocol</span>
        <span>Verified Partner Quality</span>
      </div>
    </article>
  </main>
</Layout>